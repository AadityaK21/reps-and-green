# ==== Merova Fit backend ====
# Copy to .env and fill real values. NEVER commit .env
MONGO_URL=mongodb://localhost:27017
DB_NAME=repsandgreens

# --- auth / tokens ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_MIN=10080            # access token lifetime (lower to ~60 in prod + rely on refresh)
REFRESH_EXPIRES_DAYS=30          # refresh token / session lifetime
RESET_TOKEN_EXPIRES_MIN=30       # password-reset link lifetime
BASE_URL=http://localhost:8000   # used to build links in emails

# Coach bootstrap (created by seed.py) — this account holds admin rights
COACH_EMAIL=coach@merova.app
COACH_NAME=Merova Coach
COACH_PASSWORD=change-me

# --- commerce ---
MEMBER_DISCOUNT_PCT=0.15         # loyalty discount on every cart
TAX_PCT=0.0                      # e.g. 0.18 for 18% GST; 0 disables tax

# Razorpay (public key id is safe for frontend; secret stays here ONLY)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- messaging / notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WA_FROM=whatsapp:+14155238886
RESEND_API_KEY=
EMAIL_FROM=Merova Fit <hello@merova.app>
FCM_SERVER_KEY=                  # Firebase Cloud Messaging (mobile push)

# --- social sign-in ---
GOOGLE_CLIENT_ID=                # verified server-side via tokeninfo
APPLE_CLIENT_ID=                 # your services/bundle id (aud) for Apple Sign-In

# --- caching / real-time (optional; falls back to in-process when unset) ---
REDIS_URL=

# --- cloud storage: local | s3 | cloudinary ---
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
CLOUDINARY_URL=

# --- Android app (fill after building the APK with PWABuilder) ---
ANDROID_PACKAGE=                 # e.g. app.merova.fit
ANDROID_CERT_SHA256=             # signing key SHA-256 fingerprint(s), comma-separated

# --- CORS / hardening ---
FRONTEND_ORIGIN=http://localhost:5173
ENV=development                  # development | production
LOG_LEVEL=INFO
MAX_UPLOAD_MB=8
