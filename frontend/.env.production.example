# ==== Reps & Greens frontend - PRODUCTION ====
# On Vercel these go in Project → Settings → Environment Variables.
# VITE_ vars are baked in at build time, so set them BEFORE deploying.

# Your Render backend URL (no trailing slash):
VITE_API_URL=https://reps-greens-api.onrender.com

# Razorpay PUBLIC key id (safe in frontend). Leave the test key if not using payments yet.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
